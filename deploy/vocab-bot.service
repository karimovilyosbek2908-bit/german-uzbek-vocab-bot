[Unit]
Description=Nemis-o'zbek so'z boyligi Telegram boti
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- o'zingiznikiga moslang ---
User=ubuntu
WorkingDirectory=/home/ubuntu/german-uzbek-vocab-bot
EnvironmentFile=/home/ubuntu/german-uzbek-vocab-bot/.env
ExecStart=/usr/bin/python3 /home/ubuntu/german-uzbek-vocab-bot/bot.py
# venv ishlatsangiz:
#   ExecStart=/home/ubuntu/german-uzbek-vocab-bot/.venv/bin/python bot.py

Restart=always
RestartSec=5

# yengil xavfsizlik cheklovlari
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
